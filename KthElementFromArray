class Solution {
public:
    double KthElement(vector<int>& nums1, vector<int>& nums2 , k) 
    {
        int n1 = nums1.size();
        int n2 = nums2.size();

        if (n1 > n2) 
            return  KthElement(nums2, nums1);

        int low = max(0,k-n2), high = min(k,n1);
        int pattern = (n1 + n2 + 1) / 2;
        int n = n1 + n2;

        while (low <= high)
        {
            int mid1 = (low + high) / 2;
            int mid2 = pattern - mid1;

            int l1 = (mid1 == 0) ? INT_MIN : nums1[mid1 - 1];
            int r1 = (mid1 == n1) ? INT_MAX : nums1[mid1];

            int l2 = (mid2 == 0) ? INT_MIN : nums2[mid2 - 1];
            int r2 = (mid2 == n2) ? INT_MAX : nums2[mid2];

            if (l1 <= r2 && l2 <= r1)
            {
                return max(l1, l2);
            }
            else if (l1 > r2)
                high = mid1 - 1;
            else
                low = mid1 + 1;
        }

        return 0.0;
    }
};
